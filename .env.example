# LLM / Embedding
DASHSCOPE_API_KEY=your_dashscope_api_key
DASHSCOPE_BASE_HTTP_API_URL=https://dashscope.aliyuncs.com/api/v1
MODEL=qwen-plus
USE_LLM=true
EMBEDDING_MODEL=text-embedding-v1
EMBEDDING_DIM=1536

# External APIs
OPENWEATHER_API_KEY=your_openweather_api_key
AMAP_API_KEY=your_amap_web_api_key

# Optional transport / hotel APIs
TRAIN_API_URL=
TRAIN_API_KEY=
FLIGHT_API_URL=
FLIGHT_API_KEY=
HOTEL_API_URL=
HOTEL_API_KEY=

# Milvus
RAG_BACKEND=auto
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_COLLECTION=travel_knowledge
MILVUS_METRIC_TYPE=COSINE
MILVUS_INDEX_TYPE=HNSW

# Runtime
OUTPUT_DIR=output
SQLITE_DB_PATH=data/travel_agent.db
KNOWLEDGE_FILE=data/travel_knowledge.md

# false = stable fixed LangGraph workflow.
# true  = create_react_agent + MultiServerMCPClient, model chooses MCP tools.
USE_MCP=false
MCP_SERVERS_CONFIG=servers_config.json
REQUEST_TIMEOUT=12
